<Window x:Class="LibraryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LibraryApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="10,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    
                    <Button x:Name="btnLogin" Content="Войти" Style="{StaticResource NavButton}" Click="BtnLogin_Click"/>
                    <Button x:Name="btnLogout" Content="Выйти" Style="{StaticResource NavButton}" Click="BtnLogout_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Библиотека" Foreground="White" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button x:Name="btnCatalog" Content="Каталог книг" Style="{StaticResource NavButton}" Click="BtnCatalog_Click"/>
                    <Button x:Name="btnBooking" Content="Забронировать" Style="{StaticResource NavButton}" Click="BtnBooking_Click"/>
                    <Button x:Name="btnMyBookings" Content="Мои брони" Style="{StaticResource NavButton}" Click="BtnMyBookings_Click"/>
                    <Button x:Name="btnAllBookings" Content="Все брони" Style="{StaticResource NavButton}" Click="BtnAllBookings_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>

    </DockPanel>
</Window>
