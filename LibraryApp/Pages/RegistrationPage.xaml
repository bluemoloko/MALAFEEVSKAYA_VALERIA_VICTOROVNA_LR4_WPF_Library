<Page x:Class="LibraryApp.Pages.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LibraryApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="800"
      Title="RegistrationPage">

    <Grid>
        <Border Background="White" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1"
            CornerRadius="8" Padding="30" Width="400" Margin="0,20" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Регистрация" Style="{StaticResource TitleText}" HorizontalAlignment="Center"/>

                <TextBlock Text="Роль" Style="{StaticResource LabelText}"/>
                <ComboBox x:Name="cbRole" SelectedIndex="0" SelectionChanged="CbRole_SelectionChanged">
                    <ComboBoxItem Content="Читатель" Tag="Reader"/>
                    <ComboBoxItem Content="Библиотекарь" Tag="Librarian"/>
                </ComboBox>

                <TextBlock Text="Логин" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="txtLogin" MaxLength="50"/>

                <TextBlock Text="Пароль" Style="{StaticResource LabelText}"/>
                <PasswordBox x:Name="pbPassword"/>

                <TextBlock Text="ФИО" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="txtFullName" MaxLength="100"/>

                <TextBlock Text="Телефон" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="txtPhone" MaxLength="20"/>

                <StackPanel x:Name="panelAddress">
                    <TextBlock Text="Адрес (необязательно)" Style="{StaticResource LabelText}"/>
                    <TextBox x:Name="txtAddress" MaxLength="255"/>
                </StackPanel>

                <StackPanel x:Name="panelCode" Visibility="Collapsed">
                    <TextBlock Text="Код библиотекаря" Style="{StaticResource LabelText}"/>
                    <PasswordBox x:Name="pbCode"/>
                </StackPanel>

                <Button Content="Зарегистрироваться" Margin="4,16,4,4" Click="BtnRegister_Click"/>
                <Button Content="Назад ко входу" Background="#7B8794" Click="BtnBack_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
