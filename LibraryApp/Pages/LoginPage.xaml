<Page x:Class="LibraryApp.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LibraryApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">

    <Grid>
        <Border Background="White" BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1"
            CornerRadius="8" Padding="30" Width="360" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Вход в систему" Style="{StaticResource TitleText}" HorizontalAlignment="Center"/>

                <TextBlock Text="Логин" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="txtLogin"/>

                <TextBlock Text="Пароль" Style="{StaticResource LabelText}"/>
                <PasswordBox x:Name="pbPassword"/>

                <Button Content="Войти" Margin="4,16,4,4" Click="BtnLogin_Click" IsDefault="True"/>
                <Button Content="Регистрация" Click="BtnRegister_Click"/>
                <Button Content="Продолжить как гость" Background="#7B8794" Click="BtnGuest_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
