<Page x:Class="LibraryApp.Pages.AllBookingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LibraryApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AllBookingsPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Все бронирования" Style="{StaticResource TitleText}"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Поиск по читателю или книге" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="txtSearch" TextChanged="Filter_Changed"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Статус" Style="{StaticResource LabelText}"/>
                <ComboBox x:Name="cbStatus" SelectionChanged="Filter_Changed" SelectedIndex="0">
                    <ComboBoxItem Content="Все" Tag=""/>
                    <ComboBoxItem Content="Забронировано" Tag="Reserved"/>
                    <ComboBoxItem Content="Выдано" Tag="Issued"/>
                    <ComboBoxItem Content="Возвращено" Tag="Returned"/>
                    <ComboBoxItem Content="Просрочено" Tag="Overdue"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <DataGrid x:Name="dgLoans" Grid.Row="2" Margin="4,12,4,4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding LoanId}" Width="50"/>
                <DataGridTextColumn Header="Книга" Binding="{Binding Title}" Width="2*"/>
                <DataGridTextColumn Header="Читатель" Binding="{Binding ReaderName}" Width="*"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding ReaderPhone}" Width="120"/>
                <DataGridTextColumn Header="Дата брони" Binding="{Binding LoanDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Возврат" Binding="{Binding ReturnDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
            <Button Content="Выдать" Click="BtnIssue_Click"/>
            <Button Content="Принять возврат" Click="BtnReturn_Click"/>
            <Button Content="Просрочено" Click="BtnOverdue_Click"/>
            <Button Content="Удалить"  Click="BtnDelete_Click"/>
        </WrapPanel>
    </Grid>
</Page>
